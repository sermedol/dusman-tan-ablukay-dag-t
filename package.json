{
  "name": "umut-sen-platform",
  "version": "0.1.0",
  "description": "Düşmanı Tanı, Ablukayı Dağıt - Research, mapping and relationship analysis platform",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "type-check": "turbo run type-check",
    "db:migrate": "cd packages/database && pnpm migrate",
    "db:seed": "cd packages/database && pnpm seed",
    "db:reset": "cd packages/database && pnpm reset",
    "clean": "turbo run clean && rm -rf node_modules",
    "platform:export": "node scripts/platform-export.js",
    "platform:restore": "node scripts/platform-restore.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "commitlint": "^19.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.6.3"
    }
  }
}
