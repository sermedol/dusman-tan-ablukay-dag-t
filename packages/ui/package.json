{
  "name": "@dusman/ui",
  "version": "1.0.0",
  "description": "Shared UI components for Dusman platform",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./button": "./src/components/Button.tsx",
    "./card": "./src/components/Card.tsx",
    "./input": "./src/components/Input.tsx",
    "./modal": "./src/components/Modal.tsx",
    "./form": "./src/components/Form.tsx",
    "./select": "./src/components/Select.tsx",
    "./textarea": "./src/components/Textarea.tsx"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "typescript": "^5.6.3"
  }
}
