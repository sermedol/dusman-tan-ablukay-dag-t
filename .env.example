# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/umutsensen_dev
DATABASE_SHADOW_URL=postgresql://postgres:postgres@localhost:5432/umutsensen_shadow

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=test_master_key

# Object Storage (S3-compatible)
S3_REGION=us-east-1
S3_BUCKET=umutsensen-local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# API
API_PORT=3001
API_HOST=0.0.0.0

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin
ADMIN_PORT=3002
ADMIN_NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
ADMIN_NEXT_PUBLIC_BASE_URL=http://localhost:3002

# Auth
AUTH_SECRET=your-super-secret-key-change-in-production
AUTH_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Google Drive (optional)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
