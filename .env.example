# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/umutsensen_dev
DATABASE_SHADOW_URL=postgresql://postgres:postgres@localhost:5432/umutsensen_shadow

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=test_master_key

# Object Storage (S3-compatible)
S3_REGION=us-east-1
S3_BUCKET=umutsensen-local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# API
API_PORT=3001
API_HOST=0.0.0.0

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin
ADMIN_PORT=3002
ADMIN_NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
ADMIN_NEXT_PUBLIC_BASE_URL=http://localhost:3002

# Auth
AUTH_SECRET=your-super-secret-key-change-in-production
AUTH_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRATION=86400

# Logging
LOG_LEVEL=info

# Google Drive / Sheets research data pipeline (optional - see
# docs/GOOGLE_DRIVE_DATA_PIPELINE.md). The app starts and runs fine with all
# of these unset; only the /data-sources/* endpoints become unavailable.
# Master switch - must be exactly "true" to enable the integration at all.
GOOGLE_DRIVE_ENABLED=false
# A Google service-account credential, as JSON (its `client_email` and
# `private_key` fields). Either the raw JSON string, or the same JSON
# base64-encoded (useful when your platform mangles multi-line env values).
# NEVER commit a real value here - this is a secret.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Spreadsheet ID of the Master Registry sheet (the "DÜŞMANI TANI — VERİ
# HAVUZU" folder's MASTER_HOLDINGS spreadsheet).
GOOGLE_MASTER_SPREADSHEET_ID=
# Drive folder ID of the research data pool root folder. Not yet read by any
# endpoint - reserved for the future BELGELER/drive_file_id document browser.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
