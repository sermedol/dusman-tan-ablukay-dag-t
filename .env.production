# Production Environment Configuration

# Database
DATABASE_URL=postgresql://user:password@db:5432/dusman_prod
DATABASE_SHADOW_URL=postgresql://user:password@db:5432/dusman_shadow

# API Server
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=production

# Frontend URLs
NEXT_PUBLIC_API_URL=https://api.dusman-tan-ablukay-dag-t.org/api/v1

# Authentication
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production

# Logging
LOG_LEVEL=info

# Security
CORS_ORIGINS=https://admin.dusman-tan-ablukay-dag-t.org,https://dusman-tan-ablukay-dag-t.org
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# File Storage (S3-compatible)
S3_REGION=us-east-1
S3_BUCKET=dusman-prod
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_USE_SSL=true

# Search
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=your-api-key

# Cache
REDIS_URL=redis://redis:6379

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@dusman-tan-ablukay-dag-t.org

# Monitoring & Logging
SENTRY_DSN=https://your-sentry-dsn
DATADOG_API_KEY=your-datadog-key
